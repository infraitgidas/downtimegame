{
  "__inputs": [],
  "__requires": [],
  "title": "Downtime Game — Observability",
  "description": "Monitoreo profesional de todos los componentes del Downtime Game: servicios HTTP, infraestructura de red, sistema y métricas del juego",
  "tags": ["downtime-game", "observability", "production"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "System Health",
      "description": "Overall system status based on all HTTP probe targets",
      "gridPos": { "h": 3, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "⚠️ DEGRADED", "color": "red" },
                "1": { "text": "✅ ALL SYSTEMS OK", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(count by (instance) (probe_success{job=\"blackbox-http\"}) == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "pluginVersion": "11.0.0"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Monitoring Uptime",
      "description": "Uptime of the monitoring LXC (CT 205)",
      "gridPos": { "h": 3, "w": 8, "x": 8, "y": 1 },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "seconds",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "color": { "mode": "none" },
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(node_time_seconds{host=\"sg-monitoring\"} - node_boot_time_seconds{host=\"sg-monitoring\"})",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "pluginVersion": "11.0.0"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Endpoints Status",
      "description": "Total HTTP endpoints and how many are healthy",
      "gridPos": { "h": 3, "w": 8, "x": 16, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "green", "value": 7 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "7": { "text": "7/7 ✅" },
                "6": { "text": "6/7 ⚠️" },
                "5": { "text": "5/7 ⚠️" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-http\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "pluginVersion": "11.0.0"
    },

    {
      "id": 5,
      "type": "row",
      "title": "Game Services",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false
    },

    {
      "id": 6,
      "type": "stat",
      "title": "sg-rojo",
      "description": "Servicio Rojo — HTTP health check",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "#DC143C", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "🔴 DOWN", "color": "red" },
                "1": { "text": "🟢 ONLINE", "color": "#DC143C" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"http://192.168.1.200:8080/health\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
