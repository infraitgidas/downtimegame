              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(probe_success{instance=~\"http://192.168.1.54:80.*\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP Response Time (ms)",
      "description": "Latencia de respuesta HTTP de cada servicio del juego",
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["last", "mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 3
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sg-rojo" },
            "properties": [{ "id": "color", "value": { "fixed": "#DC143C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sg-azul" },
            "properties": [{ "id": "color", "value": { "fixed": "#1E90FF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sg-verde" },
            "properties": [{ "id": "color", "value": { "fixed": "#00FF7F" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sg-amarillo" },
            "properties": [{ "id": "color", "value": { "fixed": "#FFD700" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "probe_http_duration_seconds{instance=\"http://192.168.1.200:8080/health\"} * 1000",
          "legendFormat": "sg-rojo",
          "refId": "A"
        },
        {
          "expr": "probe_http_duration_seconds{instance=\"http://192.168.1.204:8084/health\"} * 1000",
          "legendFormat": "sg-azul",
          "refId": "B"
        },
        {
          "expr": "probe_http_duration_seconds{instance=\"http://192.168.1.202:8082/health\"} * 1000",
          "legendFormat": "sg-verde",
          "refId": "C"
        },
        {
          "expr": "probe_http_duration_seconds{instance=\"http://192.168.1.203:8083/health\"} * 1000",
          "legendFormat": "sg-amarillo",
          "refId": "D"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Service Availability (%)",
      "description": "HTTP availability percentage over time for each service",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sg-rojo" },
            "properties": [{ "id": "color", "value": { "fixed": "#DC143C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sg-azul" },
            "properties": [{ "id": "color", "value": { "fixed": "#1E90FF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sg-verde" },
            "properties": [{ "id": "color", "value": { "fixed": "#00FF7F" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sg-amarillo" },
            "properties": [{ "id": "color", "value": { "fixed": "#FFD700" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{instance=\"http://192.168.1.200:8080/health\"}[5m]) * 100",
          "legendFormat": "sg-rojo",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(probe_success{instance=\"http://192.168.1.204:8084/health\"}[5m]) * 100",
          "legendFormat": "sg-azul",
          "refId": "B"
        },
        {
          "expr": "avg_over_time(probe_success{instance=\"http://192.168.1.202:8082/health\"}[5m]) * 100",
          "legendFormat": "sg-verde",
          "refId": "C"
        },
        {
          "expr": "avg_over_time(probe_success{instance=\"http://192.168.1.203:8083/health\"}[5m]) * 100",
          "legendFormat": "sg-amarillo",
          "refId": "D"
        }
      ]
    },

    {
      "id": 14,
      "type": "row",
      "title": "Network Infrastructure",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "ICMP Ping Latency (ms)",
      "description": "Round-trip ping time to Router, Proxmox, Game PC, and Internet",
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 15 },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["last", "mean", "min", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "asc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Router (192.168.1.1)" },
            "properties": [{ "id": "color", "value": { "fixed": "#FF8C00" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Proxmox (192.168.1.31)" },
            "properties": [{ "id": "color", "value": { "fixed": "#9370DB" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Game PC (192.168.1.54)" },
            "properties": [{ "id": "color", "value": { "fixed": "#00CED1" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Internet (8.8.8.8)" },
            "properties": [{ "id": "color", "value": { "fixed": "#32CD32" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "probe_icmp_duration_seconds{instance=\"192.168.1.1\"} * 1000",
          "legendFormat": "Router (192.168.1.1)",
          "refId": "A"
        },
        {
          "expr": "probe_icmp_duration_seconds{instance=\"192.168.1.31\"} * 1000",
          "legendFormat": "Proxmox (192.168.1.31)",
          "refId": "B"
        },
        {
          "expr": "probe_icmp_duration_seconds{instance=\"192.168.1.54\"} * 1000",
          "legendFormat": "Game PC (192.168.1.54)",
          "refId": "C"
        },
        {
          "expr": "probe_icmp_duration_seconds{instance=\"8.8.8.8\"} * 1000",
          "legendFormat": "Internet (8.8.8.8)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Network Reachability",
      "description": "ICMP ping reachability count",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 15 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "green", "value": 9 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "9": { "text": "9/9 ✅ All Reachable" },
                "8": { "text": "8/9 ⚠️" },
                "7": { "text": "7/9 ⚠️" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-icmp\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "ICMP Packet Loss",
      "description": "Packet loss detected via failed probes over time",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 15 },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-icmp\"} == 0) or vector(0)",
          "legendFormat": "Failed Pings",
          "refId": "A"
        }
      ]
    },

    {
      "id": 18,
      "type": "row",
      "title": "System Resources",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },

    {
      "id": 19,
      "type": "gauge",
      "title": "CPU Usage",
      "description": "CPU usage percentage on the monitoring LXC",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 19 },
      "options": {
