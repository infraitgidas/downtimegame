    {
      "id": 11,
      "type": "stat",
      "title": "Web Apps",
      "description": "Dashboard + Admin Panel HTTP status",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 5 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "🔴 ALL DOWN", "color": "red" },
                "1": { "text": "⚠️ PARTIAL", "color": "orange" },
